  "pricing_type": "on_demand",
  "target_generations": ["H100", "B200"],
  "state_pool_generations": ["H100", "H200", "B200"],
  "curve_windows_observations": [5, 20, 60],
  "horizon_months": [1, 3, 6],
  "knn_k": 5,
  "minimum_training_states": 8,
  "minimum_changed_origins_for_supported_result": 4,
  "minimum_prior_months_for_depreciation": 3,
  "material_improvement_fraction": 0.05,
  "gate_models": {
    "H100": "own_curve_knn",
    "B200": "transport_curve_knn"
  },
  "advancement_gate": {
    "required_generations": ["H100", "B200"],
    "required_supported_winning_horizons_per_generation": 1,
    "comparison_subset": "changed_outcomes",
    "must_beat": ["random_walk", "depreciation"],
    "minimum_relative_error_reduction": 0.05
  },
  "index_policy": {
    "provider_daily": "median price_per_gpu_hour within provider/date/generation after exact raw on_demand filtering",
    "generation_daily": "equal-provider median of provider_daily values",
    "generation_monthly": "last available generation_daily observation in each calendar month",
    "no_interpolation": true,
    "deduplicate_exact_rows": true
  },
  "curve_state_policy": {
    "source": "faithful research consumer of the continuous causal measurements from research-foundry PR #127; PR #127 itself is closed/unmerged and is not treated as current authority",
    "features": ["multi_scale_log_return", "multi_scale_log_slope", "multi_scale_acceleration", "multi_scale_realized_vol", "multi_scale_path_efficiency", "multi_scale_distance_from_high", "slope_delta", "vol_delta", "cross_horizon_direction", "cross_horizon_agreement", "micro_macro_slope_gap", "micro_macro_acceleration_gap", "transition_velocity"],
    "all_features_past_only": true,
    "distance": "robust standardized Euclidean using training-state median and MAD; zero MAD dimensions contribute zero",
    "forecast": "median forward log return of fixed-k nearest eligible states, applied to origin target price",
    "causal_training_rule": "candidate forward outcome must be observed no later than the forecast origin date"
  },
  "model_policy": {
    "own_curve_knn": "same-generation historical states only",
    "transport_curve_knn": "other-generation historical states only; target generation excluded",
    "random_walk": "origin target-generation month-end index",
    "depreciation": "causal target-generation log-price slope using only monthly observations available through origin; positive slope clipped to zero"
  },
  "boundaries": {
    "no_private_input": true,
    "no_interpolation": true,
    "no_broker_or_runtime_authority": true,
    "no_promotion_authority": true,
    "no_live_trading_change": true
  }
}
