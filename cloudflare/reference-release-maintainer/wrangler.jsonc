{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reference-release-maintainer-v1",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {
    "required": [
      "CLOUDFLARE_ACCOUNT_ID"
    ]
  },
  "secrets_store_secrets": [
    {
      "binding": "BROKER_EDITOR_TOKEN",
      "store_id": "3bdb660e7b8d4de6a1688f922f3991f7",
      "secret_name": "REFERENCE_RELEASE_BROKER_EDITOR_TOKEN"
    }
  ],
  "services": [
    {
      "binding": "MAINTENANCE_AUTHORITY",
      "service": "reference-maintenance-authority-v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAINTENANCE_LEDGER",
        "class_name": "MaintenanceLedger"
      }
    ]
  },
  "exports": {
    "MaintenanceLedger": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "BROKER_PUBLIC_ORIGIN": "https://reference-release-broker-v1.shared-compute-neutral-authorization.workers.dev"
  }
}
