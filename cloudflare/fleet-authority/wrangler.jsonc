{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-authority",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SOURCE_EXCHANGE",
        "class_name": "SourceExchange"
      }
    ]
  },
  "migrations": [
    {
      "tag": "source-exchange-v1",
      "new_sqlite_classes": [
        "SourceExchange"
      ]
    }
  ]
}
