{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reference-maintenance-authority-v1",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "services": [
    {
      "binding": "MAINTAINER",
      "service": "reference-release-maintainer-v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTHORITY_STATE",
        "class_name": "AuthorityState"
      }
    ]
  },
  "exports": {
    "AuthorityState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
