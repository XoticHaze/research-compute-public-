      }
    ]
  },
  "exports": {
    "GrantLedger": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_JOB_WORKFLOW_REF": "XoticHaze/research-compute-public-/.github/workflows/secure-compute-harness-v1.yml@477b76085c06f77fee72b57771225a66545aa43f",
