{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reference-release-broker-v1",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "GRANT_LEDGER",
        "class_name": "GrantLedger"
      }
    ]
  },
  "exports": {
    "GrantLedger": {
      "type": "durable-object",
      "state": "created",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_JOB_WORKFLOW_REF": "XoticHaze/research-compute-public-/.github/workflows/secure-compute-harness-v1.yml@a90972dc2ed07b225a85ce7e713843c1ee07bbd0",
    "ALLOWED_JOB_WORKFLOW_SHA": "a90972dc2ed07b225a85ce7e713843c1ee07bbd0",
    "MAX_ADMISSION_SECONDS": "300",
    "MAX_INTENT_SECONDS": "86400"
  }
}
